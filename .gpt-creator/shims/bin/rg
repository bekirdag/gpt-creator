#!/usr/bin/env python3
"""Small ripgrep-compatible fallback used when real rg is unavailable.

Supports the subset of functionality exercised by the automation:
  * basic regex search across files/directories
  * -n (force line numbers)
  * --files with optional -g globs
"""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path
from typing import Iterable, Iterator


def iter_paths(paths: Iterable[str], globs: list[str], want_files: bool) -> Iterator[Path]:
    resolved: list[Path] = []
    for raw in paths:
        p = Path(raw)
        if p.is_dir():
            resolved.extend(p.rglob("*"))
        elif p.exists():
            resolved.append(p)
    for path in resolved:
        if path.is_dir():
            continue
        if globs:
            matched = False
            for pattern in globs:
                if path.match(pattern):
                    matched = True
                    break
            if not matched:
                continue
        yield path
    if want_files and not resolved:
        # ripgrep treats "." as default when no paths supplied
        yield from iter_paths(["."], globs, want_files=False)


def cmd_files(args: argparse.Namespace) -> int:
    seen = False
    for path in iter_paths(args.paths or ["."], args.glob or [], want_files=True):
        print(str(path))
        seen = True
    return 0 if seen else 1


def cmd_search(args: argparse.Namespace) -> int:
    pattern = re.compile(args.pattern, re.MULTILINE)
    paths = args.paths or ["."]
    line_numbers = args.number or True  # ripgrep shows numbers by default
    matches = 0
    for path in iter_paths(paths, args.glob or [], want_files=False):
        path_str = str(path)
        try:
            text = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            text = path.read_text(encoding="utf-8", errors="ignore")
        for idx, line in enumerate(text.splitlines(), 1):
            if not pattern.search(line):
                continue
            if line_numbers:
                print(f"{path_str}:{idx}:{line}")
            else:
                print(f"{path_str}:{line}")
            matches += 1
    return 0 if matches else 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="rg", add_help=False)
    parser.add_argument("-n", "--line-number", dest="number", action="store_true")
    parser.add_argument("--files", action="store_true")
    parser.add_argument("-g", dest="glob", action="append")
    parser.add_argument("--help", action="help")
    parser.add_argument("pattern", nargs="?")
    parser.add_argument("paths", nargs="*")
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.files:
        return cmd_files(args)
    if not args.pattern:
        parser.error("pattern required unless --files is supplied")
    return cmd_search(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        raise SystemExit(0)
