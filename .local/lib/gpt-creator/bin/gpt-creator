gc_template_path() {
  local name="${1:?template name required}"
  printf '%s/%s' "$GC_TEMPLATE_DIR" "$name"
}

gc_render_template_fallback() {
  local name="${1:?template name required}"
  case "$name" in
    prompts/work_on_tasks_diff_reminder.md)
      printf '%s\n' \
        "## Diff reminder" \
        "- Provide explicit unified diffs for the required edits." \
        "- If no changes are necessary, clearly explain why the existing implementation already satisfies the task."
      return 0
      ;;
    prompts/work_on_tasks_json_reminder.md)
      printf '%s\n' \
        "## Reminder" \
        "- Output a single JSON object exactly as described above; do not include any explanatory text outside the JSON." \
        "- If no changes are required, return the JSON with an empty \`changes\` array and clear notes explaining why." \
        "- Diff entries must remain valid unified diffs."
      return 0
      ;;
    prompts/work_on_tasks_contract_guard.md)
      printf '%s\n' \
        "## Critical constraint" \
        "- Provide at least one concrete repository change (diff or file write) or explicitly document a blocker with evidence that proves no change is required." \
        "- Do not repeat the previous plan without actionable modifications."
      return 0
      ;;
    checkpoints/empty_apply_checkpoint.md.tmpl)
      local checkpoint_title="${GC_CHECKPOINT_TITLE:-story/task}"
      local checkpoint_timestamp="${GC_CHECKPOINT_TIMESTAMP:-$(date -u +%FT%TZ)}"
      printf '# Checkpoint — %s\n\n' "$checkpoint_title"
      printf 'Generated automatically because the agent response contained no actionable '\''changes'\''.\n\n'
      printf -- '- Timestamp: %s\n' "$checkpoint_timestamp"
      printf -- '- Runner: gc-empty-apply-fallback\n\n'
      printf '## What was attempted\n'
      printf -- '- Review the raw agent output under .gpt-creator/staging/plan/work/runs for detailed context.\n'
      return 0
      ;;
  esac
  return 1
}

gc_render_template() {
  local name="${1:?template name required}"
  local template_path
  template_path="$(gc_template_path "$name")"
  if [[ ! -f "$template_path" ]]; then
    if gc_render_template_fallback "$name"; then
      return 0
    fi
    die "Template not found: ${template_path}"
  fi
  local python_bin="${PYTHON_BIN:-python3}"
  if ! command -v "$python_bin" >/dev/null 2>&1; then
    die "Python runtime '$python_bin' not available for template rendering"
  fi
  "$python_bin" -c 'import os, sys
from string import Template

path = sys.argv[1]
with open(path, "r", encoding="utf-8") as fh:
    data = fh.read()
tmpl = Template(data)
sys.stdout.write(tmpl.safe_substitute(os.environ))' "$template_path"
}

gc_configure_tmpdir() {
  local base="${1:-${PROJECT_ROOT:-$PWD}}"
  local dir="${base}/.gpt-creator/tmp"
  if mkdir -p "$dir" 2>/dev/null; then
    GC_TMP_DIR="$dir"
    TMPDIR="$dir"
    export GC_TMP_DIR TMPDIR
    mkdir -p "${base}/tmp" 2>/dev/null || true
  else
    if [[ -n "${GC_TMP_DIR:-}" ]]; then
      :
    elif [[ -n "${TMPDIR:-}" && -d "${TMPDIR}" ]]; then
      GC_TMP_DIR="$TMPDIR"
      export GC_TMP_DIR
    fi
  fi
}

