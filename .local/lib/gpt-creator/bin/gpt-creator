    export NODE_OPTIONS
  fi
fi

TS_PRELOAD="${GC_RUNTIME_DIR}/ts-preload.cjs"
if [[ -f "$TS_PRELOAD" ]]; then
  case " ${NODE_OPTIONS:-} " in
    *"$TS_PRELOAD"*)
      ;;
    *)
      if [[ -n "${NODE_OPTIONS:-}" ]]; then
        export NODE_OPTIONS="--require $TS_PRELOAD ${NODE_OPTIONS}"
      else
        export NODE_OPTIONS="--require $TS_PRELOAD"
      fi
      ;;
  esac
fi

GC_SCHEMA_EVIDENCE_PATH="${GC_WORKSPACE_DIR:-$PWD}/.gpt-creator/index/schema-evidence.json"
mkdir -p "$(dirname "$GC_SCHEMA_EVIDENCE_PATH")"
if command -v node >/dev/null 2>&1; then
  node "$CLI_ROOT/scripts/schema_evidence.js" build --out "$GC_SCHEMA_EVIDENCE_PATH" >/dev/null 2>&1 || true
fi
export GC_SCHEMA_EVIDENCE_PATH

if gc_reports_enabled; then
  trap 'gc_reports_activity_trap "$BASH_COMMAND"' DEBUG
fi

trap 'gc_child_unhandled_bridge "Unhandled error from child process"' USR1
trap 'gc_interrupt_handler INT' INT
trap 'gc_interrupt_handler TERM' TERM
trap 'gc_interrupt_handler TSTP' TSTP
trap 'gc_interrupt_handler QUIT' QUIT

trap 'gc_capture_error_context $? "$BASH_COMMAND"' ERR
trap 'gc_exit_handler $?' EXIT

main "$@"
