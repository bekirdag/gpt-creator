GC_CMD_DIR="${GC_SCRIPTS_ROOT}/commands"
gc_load_cmd() {
  local name="${1:-}"
  local path="${GC_CMD_DIR}/${name}.sh"
  if ! declare -F "cmd_${name//-/_}" >/dev/null && [[ -f "$path" ]]; then
    # shellcheck source=/dev/null
    . "$path"
  fi
}

gc_usage_commands() {
  local -a cmds=()
  local -a skip=("work_on_tasks_impl")
  if [[ -d "$GC_CMD_DIR" ]]; then
    local f
    for f in "$GC_CMD_DIR"/*.sh; do
      [[ -f "$f" ]] || continue
      local name
      name="$(basename "$f" .sh)"
      case " ${skip[*]} " in
        *" ${name} "*) continue ;;
      esac
      cmds+=("$name")
    done
  fi
  # Include commands handled outside scripts/commands or via direct scripts.
  cmds+=(
    create-sds
    create-pdr
    create-jira-tasks
    create-db-dump
    sweep-artifacts
    tidy-progress
    task-convert
    docdex
    binder
    help
    version
  )
  printf '%s\n' "${cmds[@]}" | awk 'NF' | sort -u
}

