services:
  db:
    image: mysql:8.0
    container_name: ${GEN_DOCKER_PROJECT_SLUG}-db
    environment:
      MYSQL_ROOT_PASSWORD: ${GEN_DOCKER_DB_ROOT_PASS}
      MYSQL_ROOT_HOST: '%'
      MYSQL_DATABASE: ${GEN_DOCKER_DB_NAME}
      MYSQL_USER: ${GEN_DOCKER_DB_USER}
      MYSQL_PASSWORD: ${GEN_DOCKER_DB_PASS}
    ports:
      - "${GEN_DOCKER_DB_HOST_PORT}:3306"
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "-p${GEN_DOCKER_DB_ROOT_PASS}"]
      interval: 5s
      timeout: 3s
      retries: 30
    volumes:
      - db_data:/var/lib/mysql

  api:
    build:
      context: ..
      dockerfile: docker/api.Dockerfile
    container_name: ${GEN_DOCKER_PROJECT_SLUG}-api
    depends_on:
      db:
        condition: service_healthy
    environment:
      NODE_ENV: development
      DATABASE_URL: ${GEN_DOCKER_DATABASE_URL_CONTAINER}
      PORT: 3000
      GC_SERVICE: api
    command: sh -c "corepack enable pnpm && cd /workspace && CI=1 pnpm install --frozen-lockfile=false && cd apps/api && pnpm run start:dev"
    ports:
      - "${GEN_DOCKER_API_HOST_PORT}:3000"
    volumes:
      - ..:/workspace

  web:
    build:
      context: ..
      dockerfile: docker/web.Dockerfile
    container_name: ${GEN_DOCKER_PROJECT_SLUG}-web
    environment:
      NODE_ENV: development
      VITE_API_BASE: ${GEN_DOCKER_API_BASE_URL}
      GC_SERVICE: web
    command: sh -c "corepack enable pnpm && cd /workspace && CI=1 pnpm install --frozen-lockfile=false && cd apps/web && pnpm run dev -- --host 0.0.0.0"
    ports:
      - "${GEN_DOCKER_WEB_HOST_PORT}:5173"
    volumes:
      - ..:/workspace

  admin:
    build:
      context: ..
      dockerfile: docker/admin.Dockerfile
    container_name: ${GEN_DOCKER_PROJECT_SLUG}-admin
    environment:
      NODE_ENV: development
      VITE_API_BASE: ${GEN_DOCKER_API_BASE_URL}
      GC_SERVICE: admin
    command: sh -c "corepack enable pnpm && cd /workspace && CI=1 pnpm install --frozen-lockfile=false && cd apps/admin && pnpm run dev -- --host 0.0.0.0"
    ports:
      - "${GEN_DOCKER_ADMIN_HOST_PORT}:5173"
    volumes:
      - ..:/workspace

  proxy:
    image: nginx:alpine
    container_name: ${GEN_DOCKER_PROJECT_SLUG}-proxy
    depends_on:
      - web
      - admin
      - api
    ports:
      - "${GEN_DOCKER_PROXY_HOST_PORT}:80"
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro

volumes:
  db_data: {}

