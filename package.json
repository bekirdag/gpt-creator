{
  "name": "gpt-creator",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "bootstrap": "bash tools/scripts/bootstrap_dependencies.sh",
    "work:tasks": "bash tools/scripts/ops/preflight-metadata.sh && gpt-creator work-on-tasks --project .",
    "work:packed": "bash tools/scripts/ops/preflight-metadata.sh && GC_SOFT_CONTEXT=95000 GC_HARD_CONTEXT=105000 GC_MIN_OUTPUT=5000 GC_MAX_SNIPPET_LINES=120 gpt-creator work-on-tasks --project . | node .gpt-creator/shims/context-packer.mjs",
    "work:sigint-safe": "bash tools/scripts/ops/run_tasks_sigint_safe.sh",
    "lint:shell": "tools/scripts/verify/shellcheck.sh",
    "help:index": "python3 tools/scripts/verify/gen_help_index.py",
    "doc:search": "python3 src/lib/doc_registry.py search",
    "doc:register": "python3 src/lib/doc_registry.py register",
    "doc:index:check": "python3 src/lib/doc_indexer.py --check",
    "i18n:check": "node tools/scripts/i18n-check.js",
    "i18n:sync": "node tools/scripts/i18n-sync.js",
    "i18n:types": "node tools/scripts/i18n-types.js",
    "i18n:coverage": "node tools/scripts/i18n-coverage.js",
    "trace:update": "python3 tools/scripts/python/update_traceability.py",
    "fmt": "prettier -w .",
    "test": "vitest run",
    "prepare": "husky install",
    "postinstall": "npx playwright install chromium --with-deps || npx playwright install chromium"
  },
  "devDependencies": {
    "husky": "^9.0.0",
    "playwright": "^1.48.2",
    "prettier": "^3.3.3",
    "vitest": "^2.1.3"
  }
}
